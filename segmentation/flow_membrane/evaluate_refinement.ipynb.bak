{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Refinement vs Cellpose — evaluation\n",
    "\n",
    "Compares `flow_membrane_seg.py` output against the Cellpose masks it was built from.\n",
    "\n",
    "**Run this with the `mohit` kernel** (needs `skimage`, `pandas`, `matplotlib`).\n",
    "`cellpose2` does not have them.\n",
    "\n",
    "Inputs it expects:\n",
    "\n",
    "| file | from | holds |\n",
    "|---|---|---|\n",
    "| `<stem>_seg.npy` | `Run_cellpose.py` | `img`, `flows`, `masks` (the Cellpose baseline) |\n",
    "| `<stem>_seg.whole_cell.tif` | `flow_membrane_seg.py` | refined labels |\n",
    "| `<stem>_seg.cells.csv` | `flow_membrane_seg.py` | per-cell QC table |"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Config"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "# --- EDIT THESE -------------------------------------------------------------\n",
    "CELLPOSE_DIR = Path(\"/omics/odcf/analysis/OE0622_projects/mibi_shared/Amir/preprocessing/segmentation/positivity_map_v3/sorted_by_quality/High/whole_cell/TN2_hiRes_Amir_posMap2\")   # holds *_seg.npy\n",
    "REFINED_DIR  = CELLPOSE_DIR / \"flow_membrane\"                # holds *.whole_cell.tif\n",
    "# ----------------------------------------------------------------------------\n",
    "\n",
    "IOU_THR = 0.5      # overlap needed to call two cells \"the same cell\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import tifffile as tiff\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy import sparse\n",
    "from skimage.segmentation import find_boundaries\n",
    "\n",
    "plt.rcParams[\"figure.dpi\"] = 110"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Pair up the files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "149 paired FOVs\n",
      "  A_1a_C01_R01_p2_seg\n",
      "  A_1c_C01_R01_p2_seg\n",
      "  A_1d_C01_R01_p2_seg\n",
      "  A_2c_C01_R01_p2_seg\n",
      "  A_2h_C01_R01_p2_seg\n"
     ]
    }
   ],
   "source": [
    "def find_pairs(cellpose_dir=None, refined_dir=None):\n",
    "    \"\"\"Match each Cellpose _seg.npy to its refined .whole_cell.tif by stem.\"\"\"\n",
    "    cellpose_dir = Path(cellpose_dir or CELLPOSE_DIR)\n",
    "    refined_dir  = Path(refined_dir  or REFINED_DIR)\n",
    "\n",
    "    pairs = []\n",
    "    for seg in sorted(cellpose_dir.glob(\"*_seg.npy\")):\n",
    "        stem = seg.stem                                  # e.g. A_1a_..._seg\n",
    "        ref  = refined_dir / f\"{stem}.whole_cell.tif\"\n",
    "        csv  = refined_dir / f\"{stem}.cells.csv\"\n",
    "        if ref.exists():\n",
    "            pairs.append(dict(stem=stem, seg=seg, refined=ref,\n",
    "                              csv=csv if csv.exists() else None))\n",
    "    return pairs\n",
    "\n",
    "pairs = find_pairs()\n",
    "print(f\"{len(pairs)} paired FOVs\")\n",
    "if not pairs:\n",
    "    print(\"No pairs. Check CELLPOSE_DIR / REFINED_DIR, and that the refinement has run.\")\n",
    "for p in pairs[:5]:\n",
    "    print(\" \", p[\"stem\"])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_pair(p):\n",
    "    \"\"\"Return (img, cellpose_labels, refined_labels, per-cell table or None).\"\"\"\n",
    "    d = np.load(p[\"seg\"], allow_pickle=True).item()\n",
    "    img = np.asarray(d[\"img\"]).astype(np.float32)\n",
    "    cp  = np.asarray(d[\"masks\"]).astype(np.int32) if d.get(\"masks\") is not None else None\n",
    "    ref = tiff.imread(str(p[\"refined\"])).astype(np.int32)\n",
    "    tab = pd.read_csv(p[\"csv\"]) if p[\"csv\"] else None\n",
    "    return img, cp, ref, tab"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Per-FOV summary\n",
    "\n",
    "Counts and areas for both segmentations. `frac_covered` is the share of the frame\n",
    "assigned to any cell — a quick read on whether the refinement is shrinking or\n",
    "growing masks overall."
   ]
  },
